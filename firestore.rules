rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUserProfile(data, userId) {
      return data.userId == userId &&
             data.language is string && data.language.size() <= 10 &&
             data.currency is string && data.currency.size() <= 10 &&
             data.monthlyBudget is number && data.monthlyBudget >= 0 &&
             data.updatedAt is timestamp;
    }

    function isValidExpense(data, userId) {
      return data.userId == userId &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.totalAmount is number && data.totalAmount >= 0 &&
             data.currency is string && data.currency.size() <= 10 &&
             data.date is number &&
             (!('merchant' in data) || data.merchant == null || (data.merchant is string && data.merchant.size() <= 200)) &&
             data.categoryId is string && data.categoryId.size() <= 50 &&
             data.paymentMethod is string && data.paymentMethod.size() <= 50 &&
             data.source is string && data.source.size() <= 50 &&
             (!('note' in data) || data.note == null || (data.note is string && data.note.size() <= 1000)) &&
             (!('imageUri' in data) || data.imageUri == null || (data.imageUri is string && data.imageUri.size() <= 2000)) &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    function isValidExpenseItem(data, userId) {
      return data.userId == userId &&
             data.expenseId is string && data.expenseId.size() > 0 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             (!('quantity' in data) || data.quantity == null || data.quantity is number) &&
             (!('unit' in data) || data.unit == null || (data.unit is string && data.unit.size() <= 20)) &&
             (!('unitPrice' in data) || data.unitPrice == null || data.unitPrice is number) &&
             data.amount is number && data.amount >= 0 &&
             data.categoryId is string && data.categoryId.size() <= 50 &&
             data.confidence is number && data.confidence >= 0 && data.confidence <= 1 &&
             data.createdAt is timestamp;
    }

    function isValidShoppingItem(data, userId) {
      return data.userId == userId &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             (!('quantity' in data) || data.quantity == null || (data.quantity is string && data.quantity.size() <= 50)) &&
             (!('estimatedPrice' in data) || data.estimatedPrice == null || data.estimatedPrice is number) &&
             data.isPurchased is bool &&
             data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(request.resource.data, userId);
      allow update: if isOwner(userId) && isValidUserProfile(request.resource.data, userId) &&
                       request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner(userId);

      match /expenses/{expenseId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidExpense(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidExpense(request.resource.data, userId) &&
                         request.resource.data.userId == resource.data.userId;
        allow delete: if isOwner(userId);

        match /items/{itemId} {
          allow read: if isOwner(userId);
          allow create: if isOwner(userId) && isValidExpenseItem(request.resource.data, userId);
          allow update: if isOwner(userId) && isValidExpenseItem(request.resource.data, userId) &&
                           request.resource.data.userId == resource.data.userId;
          allow delete: if isOwner(userId);
        }
      }

      match /shopping_items/{itemId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidShoppingItem(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidShoppingItem(request.resource.data, userId) &&
                         request.resource.data.userId == resource.data.userId;
        allow delete: if isOwner(userId);
      }
    }
  }
}
