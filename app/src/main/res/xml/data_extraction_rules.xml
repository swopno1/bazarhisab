<?xml version="1.0" encoding="utf-8"?>
<!--
  Data extraction rules (Android 12+). Same policy as backup_rules.xml:
  the unencrypted Room database and app preferences are excluded from
  cloud backup; device-to-device transfer keeps working via the default
  inclusion of everything else.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="bazar_hisab_database" />
        <exclude domain="database" path="bazar_hisab_database-wal" />
        <exclude domain="database" path="bazar_hisab_database-shm" />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
</data-extraction-rules>
