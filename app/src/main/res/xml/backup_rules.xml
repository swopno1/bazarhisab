<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup rules (Android 12 and below use full-backup-content).
  The unencrypted Room database and app preferences hold the user's
  expense history, so they are excluded from cloud backup. Users who
  want an off-device copy can use the opt-in Firebase Cloud Sync.
-->
<full-backup-content>
    <exclude domain="database" path="bazar_hisab_database" />
    <exclude domain="database" path="bazar_hisab_database-wal" />
    <exclude domain="database" path="bazar_hisab_database-shm" />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
